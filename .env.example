# Container image and web access.
SRTL_IMAGE=ghcr.io/ramphex/srtl-manager:latest
SRTL_BIND_HOST=0.0.0.0
SRTL_WEB_PORT=5179

# Existing absolute host paths. Compose mounts each path at the same location
# inside the containers so the UI always displays the real host path.
SYMLINK_DIR=/path/to/symlinks
SRTL_LOCATION_1_PATH=/path/to/location-1
SRTL_LOCATION_2_PATH=/path/to/location-2

# PostgreSQL credentials. The password is entered once; SRTL Manager constructs
# the internal connection URL.
SRTL_POSTGRES_DB=srtl_manager
SRTL_POSTGRES_USER=srtl
SRTL_POSTGRES_PASSWORD=

# Encryption key for saved Plex tokens and Jellyfin, Radarr and Sonarr API keys.
# Required for Docker. Generate it once with: openssl rand -base64 32
# Keep a copy separately from your database backups and never change it: without
# this key, the saved credentials cannot be read and must be entered again.
# SRTL_SECRET_KEY_FILE can name a file holding the key instead, such as a Docker
# secret. Outside Docker, an unset key is generated once as secret.key in the
# data directory with mode 0600.
SRTL_SECRET_KEY=

# The worker uses this host identity when reading and writing mounted paths.
SRTL_UID=1000
SRTL_GID=1000

# Optional network security settings. Direct LAN HTTP works with these defaults.
#
# SRTL_PUBLIC_ORIGIN: the address people type to reach SRTL through a reverse
# proxy, for example https://srtl.example.com. Mutations from that origin are
# accepted, and an https origin turns on secure session cookies.
SRTL_PUBLIC_ORIGIN=
# SRTL_ALLOWED_ORIGINS: extra comma-separated origins allowed to send changes,
# for example http://192.168.1.20:5179 when SRTL_PUBLIC_ORIGIN is set and you
# also open SRTL by its LAN address.
SRTL_ALLOWED_ORIGINS=
# SRTL_TRUST_PROXY: the reverse proxies whose X-Forwarded-For and
# X-Forwarded-Proto headers are trusted, as comma-separated addresses or CIDR
# ranges, for example 192.168.1.10 or 172.18.0.0/16. Use loopback when the proxy
# runs on the same host. Leave false when nothing proxies SRTL. The value true
# is refused because it would trust headers that any client can forge.
SRTL_TRUST_PROXY=false
# SRTL_COOKIE_SECURE: defaults to true for an https SRTL_PUBLIC_ORIGIN and false
# otherwise. Set true when HTTPS is terminated in front of SRTL without a
# public origin.
# SRTL_COOKIE_SECURE=false
# SRTL_API_DOCS: serves the OpenAPI docs at /documentation to signed-in admins.
# SRTL_API_DOCS=false
# SRTL_SESSION_IDLE_HOURS: sign a browser out after this many hours without
# activity. SRTL_SESSION_MAX_AGE_DAYS: sign it out this many days after sign-in,
# however active it is.
# SRTL_SESSION_IDLE_HOURS=12
# SRTL_SESSION_MAX_AGE_DAYS=14
# SRTL_SETUP_TOKEN: first-run setup needs a one-time setup token. By default one
# is generated, printed in the API log (docker compose logs api) and saved as
# setup-token in the API data directory. Set this to 24 or more letters, digits,
# '-' or '_' to choose it yourself instead.
# SRTL_SETUP_TOKEN=
# SRTL_OUTBOUND_ALLOW_CIDRS: the addresses SRTL may call for Plex, Jellyfin,
# Radarr and Sonarr. The default, private,public, allows LAN and internet
# addresses but not this host's own loopback services. Add loopback to reach a
# server on the same host outside Docker, or list CIDR ranges to allow only
# those, for example 192.168.1.0/24. Link-local and cloud metadata addresses are
# always refused. plex.tv sign-in is not affected.
# SRTL_OUTBOUND_ALLOW_CIDRS=private,public
# SRTL_DISCARD_UNREADABLE_CREDENTIALS: only if the secret key is lost. Start once
# with true to remove the saved credentials the current key cannot read, enter
# them again in Settings, then remove this line.
# SRTL_DISCARD_UNREADABLE_CREDENTIALS=false

# Parallel job slots hosted by the single worker service. One preserves the
# existing serial behavior. The total limit defaults to SRTL_WORKER_COUNT and
# per-type limits default to that total. Copy file concurrency defaults to one;
# the independent process-wide active-file limit defaults to the worker count.
SRTL_WORKER_COUNT=1
# SRTL_MAX_RUNNING_JOBS=1
# SRTL_MAX_RUNNING_SCANS=1
# SRTL_MAX_RUNNING_AUDITS=1
# SRTL_MAX_RUNNING_COPIES=1
# SRTL_COPY_FILE_CONCURRENCY=1
# SRTL_MAX_ACTIVE_COPY_FILES=1

# Terminal job, event, audit, and scan history retention. Zero preserves all
# history. Jobs with unresolved copy recovery state are never removed.
SRTL_JOB_HISTORY_RETENTION_DAYS=90
